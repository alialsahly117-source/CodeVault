# Leave unset for local dev — Vite proxies /api to http://localhost:4000.
# In production, point this at the API's public origin, e.g. https://api.codevault.com/api
VITE_API_URL=""

# Where the "لوحة التحكم" link in the navbar points staff members to.
VITE_ADMIN_URL="http://localhost:3001"

# Google Analytics 4 Measurement ID (starts with "G-"). Leave unset to skip
# loading gtag.js entirely — local dev stays untracked by default.
VITE_GA_MEASUREMENT_ID=""
