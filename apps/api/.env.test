DATABASE_URL="postgresql://codevault:codevault@localhost:5434/codevault_test?schema=public"

NODE_ENV="test"
PORT=4001

JWT_ACCESS_SECRET="test_only_access_secret_never_use_in_production_1234567890"
JWT_REFRESH_SECRET="test_only_refresh_secret_never_use_in_production_1234567890"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
TWO_FACTOR_ENCRYPTION_KEY="test_only_two_factor_key_never_use_in_production_1234567890"

COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

WEB_URL="http://localhost:5173"
ADMIN_URL="http://localhost:3001"

# Switches the translation feature on so its routes are reachable in tests.
# Never used against the real API: the tests either hit the cache before any
# call happens, or stub global fetch.
ANTHROPIC_API_KEY="test_only_anthropic_key_never_used_for_real_calls"
