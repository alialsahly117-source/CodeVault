DATABASE_URL="postgresql://codevault:codevault@localhost:5434/codevault?schema=public"

PORT=4000

# The two frontends that are allowed to call this API with credentials.
WEB_URL="http://localhost:5173"
ADMIN_URL="http://localhost:3001"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

COOKIE_SECURE="false"
# "lax" for local dev. Set to "none" when the frontends and this API live on
# unrelated domains in production (e.g. *.netlify.app calling *.onrender.com) —
# required for the auth cookie to survive that cross-site request.
COOKIE_SAMESITE="lax"
# Only needed in production, e.g. ".codevault.com" — shares the auth cookie
# across codevault.com / admin.codevault.com / api.codevault.com.
COOKIE_DOMAIN=""
